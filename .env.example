# Copy to .env and fill in. .env is gitignored; never commit a real key.

# REQUIRED for anything beyond a single test wallet.
# The public Solana endpoint cannot carry this app: see tools/bench-rpc.mjs.
# Recommended: Helius free tier. Permanent, 1M credits/month, 10 rps, and
# archival calls bill at 1 credit with no deep-history surcharge.
# Note QuickNode's free plan is a 30-day trial, not an ongoing tier.
SOLANA_RPC=

# getTransaction calls sent per HTTP request.
# 5 is the ceiling on the public endpoint. Raise to 100 on a real provider.
RPC_BATCH=100

# How deep to read a wallet's history. Each signature costs one archival call,
# so this is the main dial on how fast you burn a monthly quota.
MAX_SIGNATURES=400

# Tokens priced per scan, chosen by how much capital went through them.
# Bounded by the price API, not the RPC.
MAX_TOKENS=30

# Concurrent scans. The free GeckoTerminal price tier allows ~30 calls/min,
# which is the real constraint here, not the RPC.
MAX_CONCURRENT_SCANS=2

PORT=3000
